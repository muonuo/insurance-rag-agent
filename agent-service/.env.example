# ===== 应用 =====
APP_NAME=安心保智能顾问
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=false

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=change-me
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ===== 大模型 =====
DEEPSEEK_API_KEY=your-deepseek-api-key
CHAT_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 日志 =====
LOGGING_LEVEL=INFO

# ===== RAG =====
MINERU_TOKEN=your-mineru-token
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# RRF融合平滑常数（10~100，越大越弱化头部名次优势）
RRF_K=60
# 第二阶段精排模型（DashScope），可选 gte-rerank-v2 / qwen3.7-text-rerank
RERANK_MODEL=qwen3.7-text-rerank

# ===== 安全认证 =====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=168

# ===== Langfuse可观测性（自托管看板地址见 deploy/langfuse-compose.yml）=====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3100

# ===== 在线RAG评测（需先启用Langfuse）=====
# 对真实RAG回答按采样率用裁判模型打分(faithfulness/answer_relevancy)并回写trace
ONLINE_EVAL_ENABLED=false
ONLINE_EVAL_SAMPLE_RATE=0.1
# answer_relevancy需要embedding；默认指向本地Ollama（与离线评测一致）
ONLINE_EVAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
ONLINE_EVAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ===== RAG检索缓存（L1 Redis）=====
RAG_CACHE_ENABLED=true
RAG_CACHE_REDIS_URL=redis://localhost:6380/0
RAG_CACHE_TTL=3600

# ===== 会话短期记忆（Redis + 摘要压缩）=====
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_REDIS_URL=redis://localhost:6380/1
SESSION_MEMORY_TTL=3600
SESSION_MEMORY_RECENT_MESSAGES=10
